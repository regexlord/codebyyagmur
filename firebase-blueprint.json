{
  "entities": {
    "VisitEvent": {
      "title": "VisitEvent",
      "description": "Anonymous daily portfolio visit event without PII.",
      "type": "object",
      "properties": {
        "dayKey": {
          "type": "string",
          "minLength": 10,
          "maxLength": 10,
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
          "description": "UTC date key in YYYY-MM-DD format."
        },
        "country": {
          "type": "string",
          "minLength": 2,
          "maxLength": 7,
          "pattern": "^([A-Z]{2}|UNKNOWN)$",
          "description": "ISO 3166-1 alpha-2 country code or UNKNOWN."
        },
        "deviceType": {
          "type": "string",
          "enum": ["desktop", "mobile", "tablet"],
          "maxLength": 10,
          "description": "Coarse device form factor."
        },
        "lang": {
          "type": "string",
          "minLength": 2,
          "maxLength": 2,
          "pattern": "^(bg|cs|de|en|fr|it|pl|ru|sv|tr|zh)$",
          "description": "Active portfolio UI language."
        },
        "referrerHost": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "pattern": "^[a-zA-Z0-9._\\-]{1,80}$",
          "description": "Sanitized referring hostname or direct."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of the visit."
        }
      },
      "required": ["dayKey", "country", "deviceType", "lang", "referrerHost", "createdAt"]
    },
    "SectionClick": {
      "title": "SectionClick",
      "description": "Anonymous section or project interaction event without PII.",
      "type": "object",
      "properties": {
        "section": {
          "type": "string",
          "minLength": 1,
          "maxLength": 48,
          "pattern": "^[a-z0-9_\\-]{1,48}$",
          "description": "Canonical identifier of clicked section or action."
        },
        "detail": {
          "type": "string",
          "minLength": 0,
          "maxLength": 80,
          "description": "Optional non-PII item label (e.g. project or cert name)."
        },
        "dayKey": {
          "type": "string",
          "minLength": 10,
          "maxLength": 10,
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
          "description": "UTC date key in YYYY-MM-DD format."
        },
        "country": {
          "type": "string",
          "minLength": 2,
          "maxLength": 7,
          "pattern": "^([A-Z]{2}|UNKNOWN)$",
          "description": "ISO 3166-1 alpha-2 country code or UNKNOWN."
        },
        "lang": {
          "type": "string",
          "minLength": 2,
          "maxLength": 2,
          "pattern": "^(bg|cs|de|en|fr|it|pl|ru|sv|tr|zh)$",
          "description": "Active portfolio UI language."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of the click event."
        }
      },
      "required": ["section", "detail", "dayKey", "country", "lang", "createdAt"]
    },
    "AdminUser": {
      "title": "AdminUser",
      "description": "Portfolio owner admin document.",
      "type": "object",
      "properties": {
        "email": {
          "type": "string",
          "format": "email",
          "maxLength": 120,
          "description": "Verified owner email address."
        },
        "role": {
          "type": "string",
          "enum": ["owner"],
          "maxLength": 10,
          "description": "Owner role."
        }
      },
      "required": ["email", "role"]
    }
  },
  "firestore": {
    "/visitEvents/{eventId}": {
      "schema": { "$ref": "#/entities/VisitEvent" },
      "description": "Anonymous daily visitor records (create-only for public, admin-only read/delete)."
    },
    "/sectionClicks/{clickId}": {
      "schema": { "$ref": "#/entities/SectionClick" },
      "description": "Anonymous section interaction events (create-only for public, admin-only read/delete)."
    },
    "/admins/{adminId}": {
      "schema": { "$ref": "#/entities/AdminUser" },
      "description": "Owner allowlist lookup collection."
    }
  }
}
